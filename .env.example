# Runtime setting for running the backend outside Docker.
# Compose currently sets NODE_ENV=development for its local API service.
NODE_ENV=development
PORT=4000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=leadflow360
DATABASE_USER=leadflow360
DATABASE_PASSWORD=change-me-to-a-local-password
# Local PostgreSQL can use plaintext; production must enable TLS with certificate verification.
DATABASE_SSL=false
# Production only: mount the trusted PostgreSQL CA certificate read-only into the backend
# container and set this path to the mounted PEM certificate/bundle. Do not bake it into the image.
DATABASE_CA_CERT_PATH=/run/secrets/postgres-ca.crt
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h
DATABASE_TYPE=postgres
REDIS_URL=redis://localhost:6379
LEADS_CACHE_TTL_SECONDS=60
# Needed by Compose because it starts MySQL, or when DATABASE_TYPE=mysql.
# A PostgreSQL-only backend/ECS runtime does not require MYSQL_* settings.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=leadflow360_mysql
MYSQL_USER=leadflow
MYSQL_PASSWORD=replace-with-a-local-mysql-password
# Optional dedicated MySQL root password; Compose falls back to MYSQL_PASSWORD when unset.
MYSQL_ROOT_PASSWORD=change-me-to-a-separate-local-root-password
# Host-side MongoDB URI for running the backend outside Docker.
MONGODB_URI=mongodb://replace-with-mongodb-user:replace-with-mongodb-password@localhost:27017/leadflow360?authSource=admin
MONGODB_DATABASE=leadflow360
MONGODB_ROOT_USERNAME=replace-with-mongodb-root-user
MONGODB_ROOT_PASSWORD=replace-with-mongodb-root-password
# Optional Compose-only URI when DATABASE_TYPE=mongodb; use the service host `mongodb`.
MONGODB_DOCKER_URI=
LEAD_FOLLOWUP_DELAY_SECONDS=86400
LEAD_JOB_ENQUEUE_TIMEOUT_MS=3000
LEAD_JOB_WORKER_CONCURRENCY=5
# Google OAuth 2.0 delegated API access (all credentials are placeholders).
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback
GOOGLE_OAUTH_SCOPES=
GOOGLE_OAUTH_RESOURCE_URL=
# Generate with: openssl rand -base64 32
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
GOOGLE_OAUTH_TRANSACTION_TTL_SECONDS=600

# Google OpenID Connect login (uses the same Google OAuth web client, with a separate callback)
GOOGLE_OIDC_REDIRECT_URI=http://localhost:4000/api/oidc/google/callback
FRONTEND_ORIGIN=http://localhost:5173
# Frontend build-time value: Vite embeds this browser-facing API URL in its bundle.
VITE_API_BASE_URL=http://localhost:4000
