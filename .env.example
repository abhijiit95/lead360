PORT=4000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=leadflow360
DATABASE_USER=leadflow360
DATABASE_PASSWORD=change-me-to-a-local-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h
DATABASE_TYPE=postgres
REDIS_URL=redis://localhost:6379
LEADS_CACHE_TTL_SECONDS=60
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=leadflow360_mysql
MYSQL_USER=leadflow
MYSQL_PASSWORD=leadflow_password
MONGODB_URI=mongodb://leadflow:leadflow_password@localhost:27017/leadflow360?authSource=admin
MONGODB_DATABASE=leadflow360
MONGODB_ROOT_USERNAME=leadflow
MONGODB_ROOT_PASSWORD=leadflow_password
LEAD_FOLLOWUP_DELAY_SECONDS=86400
LEAD_JOB_ENQUEUE_TIMEOUT_MS=3000
LEAD_JOB_WORKER_CONCURRENCY=5
# Google OAuth 2.0 delegated API access (all credentials are placeholders).
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback
GOOGLE_OAUTH_SCOPES=
GOOGLE_OAUTH_RESOURCE_URL=
# Generate with: openssl rand -base64 32
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
GOOGLE_OAUTH_TRANSACTION_TTL_SECONDS=600
